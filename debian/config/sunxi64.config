###########################################################################
#
# Hardware specific changes, that has to be enabled or changed
#
###########################################################################
CONFIG_KEYBOARD_PINEPHONE=m
CONFIG_KEYBOARD_SUN4I_LRADC=m
CONFIG_IP5XXX_POWER=m
CONFIG_THERMAL_WRITABLE_TRIPS=y
CONFIG_V4L2_FLASH_LED_CLASS=m
CONFIG_VIDEO_SUN6I_CSI=m
CONFIG_VIDEO_SUN8I_DEINTERLACE=m
CONFIG_VIDEO_SUN8I_ROTATE=m
CONFIG_VIDEO_GC2145=m
CONFIG_VIDEO_OV5640=m
CONFIG_DRM_DW_HDMI_AHB_AUDIO=m
CONFIG_DRM_PANEL_ILITEK_ILI9881C=m
CONFIG_SND_SOC_BT_SCO=m
CONFIG_SND_SOC_EC25=m
CONFIG_LEDS_CLASS_FLASH=y
CONFIG_LEDS_SGM3140=m
CONFIG_RTW88_8723CS=m
CONFIG_ARM_SUN8I_A33_MBUS_DEVFREQ=m
CONFIG_AF8133J=m

#
# All modules related to AXP20X has to be built-in, otherwise kernel
# just don't boot. There is no serial console output even.
#
CONFIG_MFD_AXP20X_RSB=y
CONFIG_REGULATOR_AXP20X=y

#
# For FDE initramfs all modules needed for graphics has to be in
# initramfs or built-in. ANX7688 is used as hdmi-bridge and is needed to fully
# initialize display-engine. As a usb driver it isn't included in initramfs.
# To be built-in it requires TYPEC and USB_ROLE_SWITCH to be built-in as well.
#
CONFIG_TYPEC=y
CONFIG_TYPEC_ANX7688=y
CONFIG_USB_ROLE_SWITCH=y

#
# Larger CMA region is needed for stable GUI work
# To avoid frequent errors like
#  'DRM_IOCTL_MODE_CREATE_DUMB failed: Cannot allocate memory'
#
CONFIG_CMA_SIZE_MBYTES=256

#
# Debian config enables CONFIG_MEDIA_CEC_RC by default, that makes
# HDMI a potential input device and resulted in mouse cursor shown in Phosh.
#
# CONFIG_MEDIA_CEC_RC is not set


###########################################################################
#
# Disable unused options to minimize kernel size
#
###########################################################################

#
# Remove unused features
#
# CONFIG_PCI is not set
# CONFIG_EFI is not set
# CONFIG_CHROME_PLATFORMS is not set
# CONFIG_XEN is not set

#
# CPU IDLE has to be explicitly enabled here,
# because previously it was selected by some
# of the options selected by CONFIG_EFI, that is off now
#
CONFIG_CPU_IDLE=y

#
# Remove unused platforms
#
# CONFIG_ARCH_ACTIONS is not set
CONFIG_ARCH_SUNXI=y
# CONFIG_ARCH_ALPINE is not set
# CONFIG_ARCH_APPLE is not set
# CONFIG_ARCH_BCM is not set
# CONFIG_ARCH_BERLIN is not set
# CONFIG_ARCH_BITMAIN is not set
# CONFIG_ARCH_EXYNOS is not set
# CONFIG_ARCH_SPARX5 is not set
# CONFIG_ARCH_K3 is not set
# CONFIG_ARCH_LG1K is not set
# CONFIG_ARCH_HISI is not set
# CONFIG_ARCH_KEEMBAY is not set
# CONFIG_ARCH_MEDIATEK is not set
# CONFIG_ARCH_MESON is not set
# CONFIG_ARCH_MVEBU is not set
# CONFIG_ARCH_NXP is not set
# CONFIG_ARCH_LAYERSCAPE is not set
# CONFIG_ARCH_MXC is not set
# CONFIG_ARCH_S32 is not set
# CONFIG_ARCH_MA35 is not set
# CONFIG_ARCH_NPCM is not set
# CONFIG_ARCH_QCOM is not set
# CONFIG_ARCH_REALTEK is not set
# CONFIG_ARCH_RENESAS is not set
# CONFIG_ARCH_ROCKCHIP is not set
# CONFIG_ARCH_SEATTLE is not set
# CONFIG_ARCH_INTEL_SOCFPGA is not set
# CONFIG_ARCH_STM32 is not set
# CONFIG_ARCH_SYNQUACER is not set
# CONFIG_ARCH_TEGRA is not set
# CONFIG_ARCH_SPRD is not set
# CONFIG_ARCH_THUNDER is not set
# CONFIG_ARCH_THUNDER2 is not set
# CONFIG_ARCH_UNIPHIER is not set
# CONFIG_ARCH_VEXPRESS is not set
# CONFIG_ARCH_VISCONTI is not set
# CONFIG_ARCH_XGENE is not set
# CONFIG_ARCH_ZYNQMP is not set
# end of Platform selection
